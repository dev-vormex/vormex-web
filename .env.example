# Local development: REST stays same-origin through the Next.js /api rewrite,
# while the rewrite and Socket.IO both target the backend on port 5000.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_SEO_ENABLED=true
PUBLIC_SEO_ENABLED=true
INDEXNOW_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Keep GOOGLE_CLIENT_SECRET in vormex-backend only. It must never be exposed to the web app.
# Production deployments must override the backend, socket, and base URLs.
